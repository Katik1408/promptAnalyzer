{
  "name": "repromptr",
  "displayName": "RePromptr",
  "publisher": "acronite",
  "description": "AI-powered prompt optimization for LLMs. Save tokens and money by automatically optimizing prompts before sending to GPT, Claude, etc.",
  "version": "0.0.2",
  "license": "MIT",
  "icon": "images/icon.png",
  "homepage": "https://github.com/Katik1408/promptAnalyzer",
  "bugs": {
    "url": "https://github.com/Katik1408/promptAnalyzer/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Katik1408/promptAnalyzer"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Machine Learning",
    "Other"
  ],
  "keywords": ["prompt", "ai", "optimization", "gpt", "llm", "tokens"],
  "activationEvents": [
    "onCommand:promptanalyzer.runPrompt"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "promptanalyzer.runPrompt",
        "title": "Run RePromptr"
      }
    ],
    "configuration": {
      "title": "RePromptr",
      "properties": {
        "promptanalyzer.apiBaseUrl": {
          "type": "string",
          "default": "https://promptanalyzer-production.up.railway.app",
          "description": "Backend API base URL used to optimize prompts and submit feedback."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "package": "npm run check-types && node esbuild.js --production",
    "check-types": "tsc --noEmit",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "20.x",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.2",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "axios": "^1.6.2"
  }
}
